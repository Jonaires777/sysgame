# Copie para .env e ajuste se quiser (tudo é opcional).
SERVER_NAME=localhost        # nome do homeserver (parte final dos IDs: @ana:localhost). Mudar exige: docker compose down -v
BOT_PASSWORD=ultima-bot-senha
TURN_TIMEOUT=90              # segundos por jogada; 0 desliga
MAX_TIMEOUTS=3               # timeouts seguidos até remover o jogador
